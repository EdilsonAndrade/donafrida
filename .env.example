# =============================================================================
# Dona Frida — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e cadastre as mesmas chaves no
# projeto da Vercel (Settings → Environment Variables). Nunca commite valores.
# Todas as contas são da Dona Frida — não reutilize credenciais do Voxelas Duo.
# =============================================================================

# --- Banco de dados (MongoDB Atlas) ------------------------------------------
# Crie um cluster (o M0 gratuito serve) em cloud.mongodb.com → Database →
# Connect → Drivers. A aplicação grava na base "donafrida".
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=

# --- Fotos de produto e banners (Vercel Blob) --------------------------------
# Gerado ao conectar um Blob store ao projeto na Vercel (Storage → Blob).
# Em desenvolvimento local, obtenha com `vercel env pull`.
BLOB_READ_WRITE_TOKEN=

# --- URL pública do site -----------------------------------------------------
# Usada em links absolutos (e-mails, feed da Meta). Ex: https://www.donafrida.com.br
# Se vazia, cai para https://${VERCEL_URL} (automática em cada deploy da Vercel).
SITE_URL=

# --- Autenticação ------------------------------------------------------------
# Segredo da sessão do painel administrativo. Gerar com: openssl rand -base64 32
AUTH_SECRET=
# Segredo da sessão do cliente (separada da do admin). Gerar com: openssl rand -base64 32
AUTH_CLIENTE_SECRET=

# Login com Google do cliente: console.cloud.google.com → APIs e serviços →
# Credenciais → ID do cliente OAuth (aplicativo da Web).
# URI de redirecionamento a cadastrar: https://<seu-dominio>/api/auth/cliente/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Pagamentos (Mercado Pago) -----------------------------------------------
# developers.mercadopago.com.br → Suas integrações → aplicação da Dona Frida →
# Credenciais de produção (ou de teste, em desenvolvimento).
# A Public Key precisa do prefixo NEXT_PUBLIC_ porque o Payment Brick roda no navegador.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
# Gerado ao cadastrar a URL do webhook (https://<seu-dominio>/api/pagamentos/webhook)
# em Suas integrações → Webhooks; valida a assinatura x-signature.
MERCADOPAGO_WEBHOOK_SECRET=

# --- Mercado Livre -----------------------------------------------------------
# developers.mercadolivre.com.br → Suas aplicações → criar aplicação da Dona Frida.
# O par accessToken/refreshToken em uso fica no MongoDB (coleção credenciaisCanais),
# não aqui — o refreshToken é rotacionado a cada uso.
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
# Mesma URL cadastrada na aplicação: https://<seu-dominio>/api/estoque/mercado-livre/callback
MERCADOLIVRE_REDIRECT_URI=

# --- Shopee Open Platform ----------------------------------------------------
# open.shopee.com → App List. Enquanto vazias, o canal Shopee aparece como
# "não configurado" (o restante do site funciona normalmente).
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# --- Tarefas agendadas (Vercel Cron) -----------------------------------------
# Protege POST /api/estoque/sincronizar. Gerar com: openssl rand -base64 32
CRON_SECRET=

# --- E-mails transacionais (Resend) ------------------------------------------
# resend.com → API Keys, depois de verificar o domínio de envio da Dona Frida.
RESEND_API_KEY=
# Remetente verificado no Resend. Ex: naoresponda@donafrida.com.br
EMAIL_FROM=
# Recebe o aviso de cada venda paga e de cada encomenda.
ADMIN_NOTIFICACAO_EMAIL=
# WhatsApp da loja (DDD + número, ex: 19999998888). Aparece no formulário de
# encomenda e no rodapé dos e-mails. Vazio = o WhatsApp não é exibido.
NEXT_PUBLIC_LOJA_WHATSAPP=
# E-mail de contato da loja: também recebe as encomendas e é o "responder para"
# das mensagens enviadas ao cliente. Ex: contato@donafrida.com.br
LOJA_EMAIL_CONTATO=

# --- Catálogo do Facebook/Instagram (Meta) -----------------------------------
# O feed público /api/feeds/meta não precisa de chave: cadastre a URL
# https://<seu-dominio>/api/feeds/meta como fonte de dados no Commerce Manager.
# A sincronização automática via API (chaves FACEBOOK_*) é o ticket EDI-118.
